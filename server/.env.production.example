# ---------------------------------------------------------------
# Producción. Copia esto a server/.env en el servidor y rellénalo.
# ---------------------------------------------------------------
NODE_ENV=production
PORT=4000

# Cuenta de administrador que se crea en el primer arranque
ADMIN_EMAIL=hola@elliron.es
ADMIN_NAME=Equipo El Lirón
ADMIN_PASSWORD=   # 10 caracteres mínimo. Cámbiala desde el panel al entrar.

# OBLIGATORIO: genera uno con `openssl rand -base64 48`
JWT_SECRET=

# Tu dominio, con https
CORS_ORIGIN=https://elliron.es

# Comprobar las contraseñas contra filtraciones conocidas (déjalo en true)
CHECK_PWNED=true
