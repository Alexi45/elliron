# Copia este fichero a .env y cambia los valores
PORT=4000
NODE_ENV=development

# Cuenta de administrador que se crea la primera vez que arranca el servidor.
# La contraseña necesita 10 caracteres como mínimo.
ADMIN_EMAIL=hola@elliron.es
ADMIN_NAME=Equipo El Lirón
ADMIN_PASSWORD=   # pon aquí una de 10 caracteres como mínimo

# Secreto para firmar los tokens de sesión.
# En producción es obligatorio: genera uno con `openssl rand -base64 48`.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Origen permitido para el front (en producción, tu dominio)
CORS_ORIGIN=http://localhost:5185
